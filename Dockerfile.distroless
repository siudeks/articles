# Distroless Dockerfile for minimal image size and faster startup
FROM openjdk:21-jdk-slim as build

# Set working directory
WORKDIR /workspace/app

# Copy pom.xml and download dependencies
COPY pom.xml .
COPY .mvn .mvn
COPY mvnw .

# Make mvnw executable
RUN chmod +x ./mvnw

# Download dependencies
RUN ./mvnw dependency:go-offline -B

# Copy source code
COPY src src

# Build the application
RUN ./mvnw clean package -DskipTests

# Extract layers for better caching
RUN java -Djarmode=layertools -jar target/*.jar extract

# Runtime stage using distroless image
FROM gcr.io/distroless/java21-debian12:nonroot

# Copy extracted layers
COPY --from=build /workspace/app/dependencies/ ./
COPY --from=build /workspace/app/spring-boot-loader/ ./
COPY --from=build /workspace/app/snapshot-dependencies/ ./
COPY --from=build /workspace/app/application/ ./

# Expose port
EXPOSE 8080

# Set JVM options for optimal startup performance
ENV JAVA_TOOL_OPTIONS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=70.0 -XX:+UseG1GC -XX:+UseStringDeduplication -XX:+TieredCompilation -XX:TieredStopAtLevel=1"

# Run the application
ENTRYPOINT ["java", "org.springframework.boot.loader.launch.JarLauncher"]