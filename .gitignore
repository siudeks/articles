# Ignore Maven build artifacts
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Ignore IDE files
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore logs
*.log
logs/

# Ignore temporary files
*.tmp
*.temp

# Ignore Terraform files
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfplan
terraform/.terraform.lock.hcl

# Ignore Docker build context
.dockerignore

# Ignore local environment files
.env
.env.local
.env.*.local

# Ignore test results
test-results/
coverage/

# Ignore Maven wrapper jar (will be downloaded automatically)
.mvn/wrapper/maven-wrapper.jar